<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- TIA Portal V18 Openness requires .NET Framework 4.8 and a 64-bit process. -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>TiaOpennessBridge</AssemblyName>
    <RootNamespace>TiaOpennessBridge</RootNamespace>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <TiaPublicApi Condition="'$(TiaPublicApi)' == ''">C:\Program Files\Siemens\Automation\Portal V18\PublicAPI\V18</TiaPublicApi>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <!-- Never copied next to the exe: Program.cs resolves it from the TIA installation at runtime. -->
    <Reference Include="Siemens.Engineering">
      <HintPath>$(TiaPublicApi)\Siemens.Engineering.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
